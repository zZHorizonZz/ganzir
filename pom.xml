<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.horizon</groupId>
  <artifactId>ganzir-parent</artifactId>
  <version>0.3.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Ganzir</name>
  <description>A hierarchy of containers for Vert.x applications, with types and rules that you declare, stored in your
    database.</description>
  <url>https://github.com/zZHorizonZz/ganzir</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/zZHorizonZz/ganzir.git</connection>
    <developerConnection>scm:git:git@github.com:zZHorizonZz/ganzir.git</developerConnection>
    <url>https://github.com/zZHorizonZz/ganzir</url>
    <tag>HEAD</tag>
  </scm>
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/zZHorizonZz/ganzir</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/zZHorizonZz/ganzir</url>
    </snapshotRepository>
  </distributionManagement>
  <modules>
    <module>ganzir-api</module>
    <module>ganzir-database</module>
  </modules>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <aquery.version>0.3.1-SNAPSHOT</aquery.version>
    <cinder.version>0.4.1</cinder.version>
    <leadseal.version>0.2.0</leadseal.version>
    <protobuf.version>4.36.2</protobuf.version>
    <pyrite.version>0.3.0</pyrite.version>
    <vertx.version>5.2.1</vertx.version>

    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <flyway.version>13.10.3</flyway.version>
    <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>ganzir-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>pyrite-common</artifactId>
        <version>${pyrite.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>aquery-api</artifactId>
        <version>${aquery.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>aquery-grammar-ebnf</artifactId>
        <version>${aquery.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>cinder-database</artifactId>
        <version>${cinder.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>cinder-extension-protobuf</artifactId>
        <version>${cinder.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>cinder-database-sqlite</artifactId>
        <version>${cinder.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.horizon</groupId>
        <artifactId>leadseal-protobuf</artifactId>
        <version>${leadseal.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-core</artifactId>
        <version>${flyway.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-dependencies</artifactId>
        <version>${vertx.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <repositories>
    <repository>
      <id>github-aquery</id>
      <url>https://maven.pkg.github.com/zZHorizonZz/aquery</url>
    </repository>
    <repository>
      <id>github-basepoint</id>
      <url>https://maven.pkg.github.com/zZHorizonZz/basepoint</url>
    </repository>
    <repository>
      <id>github-cinder</id>
      <url>https://maven.pkg.github.com/zZHorizonZz/cinder</url>
    </repository>
    <repository>
      <id>github-leadseal</id>
      <url>https://maven.pkg.github.com/zZHorizonZz/leadseal</url>
    </repository>
    <repository>
      <id>github-pyrite</id>
      <url>https://maven.pkg.github.com/zZHorizonZz/pyrite</url>
    </repository>
  </repositories>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>3.10.4</version>
          <configuration>
            <java>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
              </includes>
              <eclipse>
                <file>${maven.multiModuleProjectDirectory}/eclipse-format.xml</file>
              </eclipse>
              <importOrder/>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>check-formatting</id>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>validate</phase>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
